FROM fedora:44

ARG HOST_UID=1000
ARG HOST_GID=1000
# Changed on every rebuild by the wrapper so cached layers (packages, Claude Code) are refetched.
ARG REFRESH=0

RUN : "${REFRESH}" && dnf install -y git make gcc procps-ng findutils which tzdata && \
    dnf clean all

RUN groupadd -g ${HOST_GID} appuser && \
    useradd -u ${HOST_UID} -g ${HOST_GID} -m appuser && \
    mkdir -p /home/appuser/.claude && chown appuser:appuser /home/appuser/.claude

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER appuser
RUN curl -fsSL https://claude.ai/install.sh | bash
USER root

# krun ignores USER and boots as root, so the entrypoint drops to appuser.
ENV PATH="/home/appuser/.local/bin:${PATH}"
WORKDIR /app
ENTRYPOINT ["/entrypoint.sh"]
CMD ["claude"]
